PORT=3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bridge_app
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=bridge_health_monitor
ADMIN_TOKEN=replace-with-a-long-random-admin-token
DEVICE_TOKEN=replace-with-a-different-device-token

# Optional email delivery: leave disabled in Settings until these are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Set true behind HTTPS; local HTTP development uses false.
COOKIE_SECURE=false

# Local phone access: 0.0.0.0; loopback-only: 127.0.0.1
HOST=127.0.0.1
# Set these behind the supplied single HTTPS reverse proxy for public hosting.
TRUST_PROXY=0
REQUIRE_SIGN_IN=false
ALLOW_LEGACY_DEVICE_TOKEN=true
PUBLIC_URL=
# Web Push: generate once with node scripts/vapid-keys.mjs, then copy the keys here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
# Optional automated backups. 0 disables. Store copies on another disk/server.
BACKUP_INTERVAL_HOURS=0
BACKUP_DIRECTORY=output/backups
MYSQLDUMP_PATH=mysqldump
